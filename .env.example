# Copy this file to .env and fill in real values.
# Never commit .env – it is ignored by .gitignore.

# PostgreSQL connection string (from Neon or Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Client identifier sent to the Oslo Bysykkel API, format: <name>-<app>
BYSYKKEL_CLIENT_ID=yourname-oslo-bysykkel-forecast